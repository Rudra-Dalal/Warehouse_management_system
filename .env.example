# ==============================================================================
# WAREHOUSE MANAGEMENT SYSTEM (WMS) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in local development, or configure these variables
# directly in your cloud hosting provider (Vercel, Render, Railway, etc.).
# NEVER commit real credentials, production connection strings, or API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel / Local Vite)
# ------------------------------------------------------------------------------
# Base URL for the FastAPI backend service (without trailing slash)
# Local: http://127.0.0.1:8000
# Production: https://your-backend-api.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI Service)
# ------------------------------------------------------------------------------
# MongoDB Connection String (Atlas Replica Set recommended for transactions)
# Standard Atlas format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local fallback: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017

# MongoDB Database Name
MONGODB_DATABASE=whitfield_wms

# JWT Authentication Secret Key (Generate a secure 64-char random hex in production)
JWT_SECRET=change-this-insecure-secret-for-production-use-only

# JWT Algorithm and Access Token Expiration (Minutes)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Admin Bootstrap Credentials (Optional)
ADMIN_EMAIL=admin@whitfield.com
ADMIN_PASSWORD=ChangeMe123!

# Google Gemini API Key (Required for AI assistant & RAG embeddings)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=

# Allowed CORS Origins (Comma-separated list of frontend domains)
# Example: http://localhost:5173,http://127.0.0.1:5173,https://your-wms-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Path to WMS Operations Handbook PDF (Optional override)
# Default: core/database/knowledge/wms_operations_and_knowledge_handbook.pdf
KNOWLEDGE_PDF_PATH=
