# ==============================================================================
# WHITFIELD WMS BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# MongoDB Connection (Atlas URI or local replica set)
MONGODB_URI=mongodb://127.0.0.1:27017
# Legacy fallback alias (optional):
# MONGODB_URL=mongodb://127.0.0.1:27017

# Database Name
MONGODB_DATABASE=whitfield_wms
# Legacy fallback alias (optional):
# DATABASE_NAME=whitfield_wms

# JWT Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin Bootstrap Credentials
ADMIN_EMAIL=admin@whitfield.com
ADMIN_PASSWORD=ReplaceWithStrongPassword123!

# Google Gemini API Key (for Live AI Assistant & RAG Semantic Search)
GEMINI_API_KEY=

# Allowed CORS Origins (comma-separated for local dev + production Vercel)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional Handbook PDF Path Override
KNOWLEDGE_PDF_PATH=
